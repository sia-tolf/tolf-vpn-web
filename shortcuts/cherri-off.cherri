#define name TOLF OFF
#question vpnDemand "Выберите TOLF AnyConnect для On Demand" "TOLF Москва iPhone"
#question vpnConnection "Выберите тот же TOLF AnyConnect для Disconnect" "TOLF Москва iPhone"
action 'is.workflow.actions.vpn.set' applyTolfOnDemand(text vpn: 'WFVPN') {
  "WFVPNOperation": "Set On Demand",
  "WFOnDemandValue": false
}
action 'is.workflow.actions.vpn.set' applyTolfConnection(text vpn: 'WFVPN') {
  "WFVPNOperation": "Disconnect"
}
applyTolfOnDemand(vpnDemand)
applyTolfConnection(vpnConnection)
