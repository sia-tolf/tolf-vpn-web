[Unit]
Description=Deliver the dedicated New York measurement certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/tolf-measurement-us-vpn-20261019/relay.py --sync
UMask=0077
StateDirectory=tolf-us-measurement-cert-sync
StateDirectoryMode=0700
RuntimeDirectory=tolf-us-measurement-cert-sync
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Nice=10
MemoryMax=128M
TasksMax=32
TimeoutStartSec=120
